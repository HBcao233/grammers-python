@final
class UpdatesState(UpdateState):
    def __new__(
        cls,
        pts: int | UpdateState | UpdatesState = 0,
        qts: int = 0,
        date: int = 0,
        seq: int = 0,
        channels: Sequence[ChannelState] = [],
    ) -> Self: ...
    def __repr__(self) -> str: ...
    def __eq__(self, other: Any, /) -> bool: ...
    @property
    def pts(self) -> int: ...
    @pts.setter
    def pts(self, pts: int) -> None: ...
    @property
    def qts(self) -> int: ...
    @qts.setter
    def qts(self, qts: int) -> None: ...
    @property
    def date(self) -> int: ...
    @date.setter
    def date(self, date: int) -> None: ...
    @property
    def seq(self) -> int: ...
    @seq.setter
    def seq(self, seq: int) -> None: ...
    @property
    def channels(self) -> list[ChannelState]: ...
    @channels.setter
    def channels(self, channels: Sequence[ChannelState]) -> None: ...

class UpdateState:
    All: TypeAlias = UpdatesState
    class Primary:
        def __new__(cls, pts: int, date: int, seq: int) -> Self: ...
        def __repr__(self) -> str: ...
        def __eq__(self, other: Any, /) -> bool: ...
        @property
        def pts(self) -> int: ...
        @property
        def date(self) -> int: ...
        @property
        def seq(self) -> int: ...

    class Secondary:
        def __new__(cls, qts: int) -> Self: ...
        def __repr__(self) -> str: ...
        def __eq__(self, other: Any, /) -> bool: ...
        @property
        def qts(self) -> int: ...

    class Channel:
        def __new__(cls, id: int, pts: int) -> Self: ...
        def __repr__(self) -> str: ...
        def __eq__(self, other: Any, /) -> bool: ...
        @property
        def id(self) -> int: ...
        @property
        def pts(self) -> int: ...

    def __repr__(self) -> str: ...
    def __eq__(self, other: Any, /) -> bool: ...
